# FlowFi — copy to .env.local and fill in values (never commit .env.local)

# Supabase (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI (required for AI insights, PDF parse-assist, /api/categorize)
OPENAI_API_KEY=sk-...

# Optional — default model if unset: gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional — set to 1 for verbose transaction debug logs in development
# NEXT_PUBLIC_DEBUG_FLOWFI_TX=1
